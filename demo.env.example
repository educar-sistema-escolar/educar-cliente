# Public credentials for the academic demonstration, including normal Vercel production builds.
# Copy to .env.local locally, or configure these eight public build variables in Vercel.
# Use the existing verified Supabase DEMO accounts; values are intentionally not committed here.
VITE_DEMO_SUPERADMIN_EMAIL=
VITE_DEMO_SUPERADMIN_PASSWORD=
VITE_DEMO_TEACHER_EMAIL=
VITE_DEMO_TEACHER_PASSWORD=
VITE_DEMO_FAMILY_EMAIL=
VITE_DEMO_FAMILY_PASSWORD=
VITE_DEMO_STUDENT_EMAIL=
VITE_DEMO_STUDENT_PASSWORD=
# Supabase private keys and server credentials must never use the VITE_ prefix.
